<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Escenarios Prospectivos: El Mundo Pos-Dólar</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Bebas+Neue&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
:root {
  --bg:        #020405; 
  --panel:     #081216;
  --green:     #00ff88;
  --green-dim: #00cc66;
  --muted:     #7ba68e; 
  --border:    #1a3324;
  --white:     #eaf2ea; 
  --amber:     #ffaa00;
  --gold:      #ffd700;
  --red:       #ff3333;
  --blue:      #0088ff;
  --purple:    #aa66ff;
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--white);font-family:'Share Tech Mono',monospace;}

/* ── HEADER & TOGGLES ── */
#header{
  position:fixed;top:0;left:0;right:0;height:65px;z-index:1000;
  background:linear-gradient(180deg,#000 0%,rgba(2,4,5,0.95) 100%);
  border-bottom:1px solid var(--border);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
}
.h-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:3px;color:var(--white);}
.toggle-container { display: flex; gap: 10px; margin-top: 5px; }
.toggle-btn {
  background: var(--panel); border: 1px solid var(--border); color: var(--muted);
  font-family: 'Share Tech Mono', monospace; font-size: 13px; padding: 4px 15px;
  cursor: pointer; transition: all 0.3s; border-radius: 2px;
}
.toggle-btn:hover { color: var(--white); border-color: var(--muted); }
.toggle-btn.active-A { background: rgba(0,136,255,0.2); border-color: var(--blue); color: var(--blue); }
.toggle-btn.active-B { background: rgba(255,170,0,0.2); border-color: var(--amber); color: var(--amber); }
.toggle-btn.active-C { background: rgba(255,51,51,0.2); border-color: var(--red); color: var(--red); }

/* ── MAP & PANEL ── */
#map{position:fixed;top:65px;left:0;right:0;bottom:140px;z-index:1;background:var(--bg);}
#info-panel{
  position:fixed;bottom:0;left:0;right:0;height:140px;z-index:1000;
  background:linear-gradient(0deg,#000 0%,rgba(8,18,22,0.95) 100%);
  border-top:1px solid var(--border);
  padding: 15px 25px; overflow-y:auto;
}
#scenario-title{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:2px;margin-bottom:5px;}
#scenario-desc{font-size:14px;line-height:1.6;color:var(--white);}

/* Leaflet Popups Ultra-Legibles */
.leaflet-popup-content-wrapper{background:#081216;border:1px solid var(--border);border-radius:2px;}
.leaflet-popup-content{font-family:'Share Tech Mono',monospace;font-size:14px !important;line-height:1.6 !important;color:var(--white);margin:12px;}
.leaflet-popup-tip{background:#081216;}
.custom-icon { display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:16px; border-radius:50%; }

/* Mobile Adaptability */
@media (max-width: 768px) {
  .h-title { font-size: 18px; }
  .toggle-btn { font-size: 11px; padding: 4px 8px; }
  #info-panel { height: 180px; padding: 12px 15px; }
  #scenario-desc { font-size: 15px !important; }
}
</style>
</head>
<body>

<div id="header">
  <div class="h-title">EL MUNDO POS-DÓLAR: TRES ESCENARIOS</div>
  <div class="toggle-container">
    <button class="toggle-btn" id="btn-A" onclick="loadScenario('A')">EL BLINDAJE</button>
    <button class="toggle-btn" id="btn-B" onclick="loadScenario('B')">LA FRACTURA</button>
    <button class="toggle-btn" id="btn-C" onclick="loadScenario('C')">EL ABISMO</button>
  </div>
</div>

<div id="map"></div>

<div id="info-panel">
  <div id="scenario-title" style="color:var(--blue);">ESCENARIO A: EL BLINDAJE</div>
  <div id="scenario-desc">Cargando análisis prospectivo...</div>
</div>

<script>
const map = L.map('map', {zoomControl: false, attributionControl: false}).setView([20, 0], 2);
L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png').addTo(map);

let currentLayers = [];
function clearMap() { currentLayers.forEach(l => map.removeLayer(l)); currentLayers = []; }
function addL(layer) { layer.addTo(map); currentLayers.push(layer); }

function createPulseIcon(color, symbol) {
  return L.divIcon({
    className: 'custom-icon',
    html: `<div style="background:${color};width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#000;box-shadow:0 0 15px ${color};">${symbol}</div>`,
    iconSize: [24,24], iconAnchor: [12,12]
  });
}

const SCENARIOS = {
  'A': {
    title: 'EL BLINDAJE',
    color: 'var(--blue)',
    desc: `<b>El costo es la soberanía.</b> El mundo se divide en dos macro-bloques herméticos. Occidente fortifica el SWIFT y expulsa a los no alineados, obligando a las naciones periféricas a elegir un bando. No hay neutralidad permitida.`,
    render: () => {
      // Bloque SWIFT (Azul)
      addL(L.polyline([[39,-77],[51,0],[52,13]], {color: '#0088ff', weight: 3, dashArray: '5, 10'}));
      addL(L.marker([39,-77], {icon: createPulseIcon('#0088ff','$')}).bindPopup("<b>Bloque Dólar/SWIFT</b><br>Acceso condicionado al alineamiento político total."));
      
      // Bloque CIPS/mBridge (Rojo)
      addL(L.polyline([[39,116],[55,37],[35,51]], {color: '#ff3333', weight: 3, dashArray: '5, 10'}));
      addL(L.marker([39,116], {icon: createPulseIcon('#ff3333','¥')}).bindPopup("<b>Bloque Yuan/CIPS</b><br>Liquidación alternativa bajo la órbita de Beijing."));
    }
  },
  'B': {
    title: 'LA FRACTURA',
    color: 'var(--amber)',
    desc: `<b>El costo es la incertidumbre.</b> Coexistencia caótica de sistemas. Operan simultáneamente el petrodólar y el petroyuan. Los estados pivotales del Sur Global navegan entre ambos sistemas asumiendo enormes costos de fricción y volatilidad cambiaria.`,
    render: () => {
      // Red Multipolo (Caos de líneas doradas)
      const nodes = [[39,116], [55,37], [28,77], [24,46], [-34,-58], [9,8]];
      for(let i=0; i<nodes.length-1; i++) {
        addL(L.polyline([nodes[i], nodes[i+1]], {color: '#ffaa00', weight: 2, opacity:0.6}));
      }
      
      // Foco Estratégico Sur (Argentina)
      addL(L.marker([-34,-58], {icon: createPulseIcon('#ffaa00','⛙')}).bindPopup("<b>Nación Pivotal</b><br>Necesidad de mantener interfaces con SWIFT (exportaciones agro) y con el ecosistema Yuan (financiamiento estatal). Costo transaccional máximo."));
      
      // Chokepoint en disputa
      addL(L.circleMarker([26,56], {color: '#ff3333', radius: 15}).bindPopup("<b>Ormuz: Condición Multidivisa</b><br>Exigencia de pagos en yuanes para cruce seguro."));
    }
  },
  'C': {
    title: 'EL ABISMO',
    color: 'var(--red)',
    desc: `<b>El costo es la supervivencia.</b> Colapso por arma financiera. La exclusión mutua destruye las cadenas logísticas. El comercio global retrocede a una regionalización extrema de bloques autárquicos. Las potencias importadoras puras se apagan.`,
    render: () => {
      // Zonas de Resiliencia (Producción Energía/Alimentos)
      addL(L.polygon([[-22,-68],[-55,-68],[-35,-50]], {color: '#00cc66', fillColor: '#00cc66', fillOpacity: 0.2})
        .bindPopup("<b>Resiliencia Base</b><br>Capacidad de sostener autonomía calórica y energética fuera del sistema financiero central."));
      
      // Chokepoints caídos
      const chokes = [[26,56,'Ormuz'], [27,34,'Suez'], [1,103,'Malaca']];
      chokes.forEach(c => {
        addL(L.marker([c[0],c[1]], {icon: createPulseIcon('#ff3333','✕')}).bindPopup(`<b>${c[2]} Clausurado</b><br>Atrición letal por ruptura del seguro marítimo en dólares.`));
      });
    }
  }
};

function loadScenario(id) {
  // UI Updates
  document.querySelectorAll('.toggle-btn').forEach(b => b.className = 'toggle-btn');
  document.getElementById('btn-'+id).classList.add('active-'+id);
  
  const s = SCENARIOS[id];
  document.getElementById('scenario-title').textContent = `ESCENARIO ${id}: ${s.title}`;
  document.getElementById('scenario-title').style.color = s.color;
  document.getElementById('scenario-desc').innerHTML = s.desc;
  
  // Map Updates
  clearMap();
  s.render();
  map.setView([20, 0], 2);
}

// Iniciar con Escenario A
loadScenario('A');
</script>
</body>
</html>
